diff --git a/clang_index_mcp/_mcp/tool_handlers/transport_tools.py b/clang_index_mcp/_mcp/tool_handlers/transport_tools.py
index 5f8a08c..3268652 100644
--- a/clang_index_mcp/_mcp/tool_handlers/transport_tools.py
+++ b/clang_index_mcp/_mcp/tool_handlers/transport_tools.py
@@ -8,10 +8,34 @@ import threading
 from ..._core import diagnostics
 
 
+def _detach_os_stdin_handle():
+    """Windows: point the OS-level STD_INPUT_HANDLE at NUL (fd 0 stays untouched).
+
+    The stdio transport blocks a thread in a synchronous read on the stdin pipe.
+    While that read is pending, CreateProcess (used by multiprocessing "spawn"
+    for the indexing workers) blocks on the same pipe handle, so the workers
+    only start once the client closes stdin and indexing never finishes.
+    """
+    if os.name != "nt":
+        return
+    try:
+        import ctypes
+        import msvcrt
+
+        nul = open(os.devnull, "rb")  # kept open for the process lifetime
+        kernel32 = ctypes.windll.kernel32
+        kernel32.SetStdHandle.argtypes = [ctypes.c_ulong, ctypes.c_void_p]
+        kernel32.SetStdHandle(0xFFFFFFF6, msvcrt.get_osfhandle(nul.fileno()))  # STD_INPUT_HANDLE
+    except Exception as e:
+        diagnostics.warning(f"Could not detach OS stdin handle: {e}")
+
+
 async def _run_stdio_transport(server):
     """Run the server using stdio transport."""
     from mcp.server.stdio import stdio_server
 
+    _detach_os_stdin_handle()
+
     async with stdio_server() as (read_stream, write_stream):
         await server.run(read_stream, write_stream, server.create_initialization_options())
 
@@ -53,4 +77,8 @@ def _install_signal_handlers():
         threading.Thread(target=_hard_shutdown, daemon=True).start()
 
     for sig in (signal.SIGINT, signal.SIGTERM):
-        loop.add_signal_handler(sig, _signal_handler)
+        try:
+            loop.add_signal_handler(sig, _signal_handler)
+        except NotImplementedError:
+            # Windows event loops do not support add_signal_handler
+            pass
